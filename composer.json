{
    "name": "co-stack/typo3-oauth2-client",
    "description": "TYPO3 OAuth2 Login Client (backend and frontend)",
    "license": [
        "GPL-2.0-or-later"
    ],
    "type": "typo3-cms-extension",
    "authors": [
        {
            "name": "Oliver Eglseder",
            "email": "oliver.eglseder@co-stack.com",
            "homepage": "https://www.co-stack.com/",
            "role": "Developer"
        },
        {
            "name": "waldhacker",
            "email": "hello@waldhacker.dev",
            "homepage": "https://waldhacker.dev",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/xima-media/typo3-oauth2-client",
    "support": {
        "issues": "https://github.com/xima-media/typo3-oauth2-client/issues",
        "source": "https://github.com/xima-media/typo3-oauth2-client"
    },
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "league/oauth2-client": "^2.7",
        "psr/log": "*",
        "typo3/cms-backend": "^13.4 || ^14.3",
        "typo3/cms-core": "^13.4 || ^14.3",
        "typo3/cms-fluid": "^13.4 || ^14.3",
        "typo3/cms-setup": "^13.4 || ^14.3"
    },
    "require-dev": {
        "eliashaeussler/typo3-vendor-bundler": "^4.1",
        "ergebnis/composer-normalize": "^2.23",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/extension-installer": "^1.0",
        "saschaegerer/phpstan-typo3": "^3.0",
        "symfony/yaml": "^6.4 || ^7.0",
        "typo3/cms-extensionmanager": "^13.4 || ^14.3",
        "typo3/cms-felogin": "^13.4 || ^14.3",
        "typo3/cms-fluid-styled-content": "^13.4 || ^14.3",
        "typo3/cms-frontend": "^13.4 || ^14.3",
        "typo3/cms-install": "^13.4 || ^14.3",
        "typo3/coding-standards": "^0.8.0",
        "typo3/testing-framework": "^8.2 || ^9.0"
    },
    "suggest": {
        "league/oauth2-github": "Github Authentication"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Waldhacker\\Oauth2Client\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waldhacker\\Oauth2Client\\Tests\\": "Tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "eliashaeussler/typo3-vendor-bundler": true,
            "ergebnis/composer-normalize": true,
            "phpstan/extension-installer": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "lock": false,
        "sort-packages": true,
        "vendor-dir": "vendor"
    },
    "extra": {
        "composer-normalize": {
            "indent-size": 4,
            "indent-style": "space"
        },
        "typo3/cms": {
            "extension-key": "oauth2_client",
            "web-dir": "public"
        }
    },
    "scripts": {
        "ci:composer:normalize": "@composer normalize --no-check-lock --dry-run",
        "ci:composer:validate": "@composer validate --no-check-lock",
        "ci:php:fixer": "php-cs-fixer fix --config build/phpcs.dist --dry-run --diff",
        "ci:php:lint": "find . -name '*.php' ! -path './vendor/*' ! -path './public/*' ! -path './var/*' ! -path '*/node_modules/*' -print0 | xargs -0 -n 1 -P 4 php -l",
        "ci:php:stan": "phpstan analyse --configuration build/phpstan.neon --no-progress",
        "ci:sca": [
            "@ci:composer:validate",
            "@ci:composer:normalize",
            "@ci:php:lint",
            "@ci:php:fixer",
            "@ci:php:stan",
            "@ci:yaml:lint"
        ],
        "ci:yaml:lint": "find . ! -path './vendor/*' ! -path './public/*' ! -path './var/*' ! -path '*/node_modules/*' \\( -name '*.yaml' -o -name '*.yml' \\) -print0 | xargs -0 -r yaml-lint",
        "composer:normalize": "@composer normalize --no-check-lock",
        "libs:bundle": "bash build/bundle-libraries.sh",
        "php:fixer": "php-cs-fixer fix --config build/phpcs.dist",
        "php:stan:baseline": "phpstan analyse --configuration build/phpstan.neon --no-progress --generate-baseline build/phpstan.baseline.neon",
        "test:functional": "phpunit -c phpunit.functional.xml",
        "test:unit": "phpunit -c phpunit.unit.xml"
    }
}
